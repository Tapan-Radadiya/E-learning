{
    "compilerOptions": {
      "target": "es6",
      "module": "commonjs",
      "outDir": "./dist",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
     "types": ["jest"],
    },
    "include": [
     "src",
     "**/*.test.ts"
  ],
    "exclude": [
      "node_modules",
      "dist"
    ]
  }